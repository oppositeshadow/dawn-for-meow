# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dawn_meow
# 可选：直接指定 SQLAlchemy URL（优先于上面的 DB_* 字段；测试用 SQLite 时写这里）
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ---- LLM（星区推演导演）----
# 默认走硅基流动（SiliconFlow，OpenAI 兼容）；换成 DeepSeek 官方只需改 base_url + model
LLM_PROVIDER=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=                  # 只写进本地 .env，绝不提交、绝不上传
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct   # 测试期用便宜小模型；正式文案可换更大的
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRY=2
LLM_BATCH_SIZE_MAX=200        # 单次语料批处理上限
LLM_DAILY_CALL_BUDGET=50      # 每日调用次数上限（自娱够用；先省钱）
LLM_DAILY_TOKEN_BUDGET=200000 # 每日 token 预算

# ---- 游戏 ----
GAME_TICK_MS=100              # 前端高频插值周期
AUTOSAVE_INTERVAL_MS=15000    # 静默快照周期
LOG_LEVEL=INFO
